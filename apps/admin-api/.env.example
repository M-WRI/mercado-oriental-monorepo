# PostgreSQL (local Docker: docker compose up -d in apps/admin-api)
DATABASE_URL=postgresql://mercado:mercado@localhost:5433/mercado

# Server
PORT=8000

# Auth — change in production
JWT_SECRET=dev-secret-change-me

# Cloudinary — required for product image uploads
# Sign up at https://cloudinary.com and copy values from the dashboard.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Optional folder prefix inside your Cloudinary account
# CLOUDINARY_FOLDER=mercado-oriental/products
