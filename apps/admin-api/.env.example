# Brevo — transactional email via REST API + templates
# https://app.brevo.com → Transactional → Email templates
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=notifications@yourdomain.com
BREVO_SENDER_NAME=Mercado Oriental

# Template IDs from Brevo (Campaigns → Email templates → copy ID)
# Required params per template — use {{ params.xxx }} in Brevo:
#   PASSWORD_RESET:        resetUrl, expiryHours
#   WELCOME_VENDOR:        name, adminUrl
#   NEW_ORDER:             shopName, customer, amount, orderUrl
#   PAYMENT_FAILED:        amount, reason, orderUrl
#   NEW_DISPUTE:           customer, reason, orderId, orderUrl
#   NEW_MESSAGE:           customerName, orderId, orderUrl
#   LOW_STOCK:             productName, variantName, available, threshold, inventoryUrl
#   NEW_REVIEW:            customer, productName, rating, stars, productUrl
#   DISPUTE_STATUS_CHANGE: orderId, oldStatus, newStatus, orderUrl
BREVO_TEMPLATE_PASSWORD_RESET=
BREVO_TEMPLATE_WELCOME_VENDOR=
BREVO_TEMPLATE_NEW_ORDER=
BREVO_TEMPLATE_PAYMENT_FAILED=
BREVO_TEMPLATE_NEW_DISPUTE=
BREVO_TEMPLATE_NEW_MESSAGE=
BREVO_TEMPLATE_LOW_STOCK=
BREVO_TEMPLATE_NEW_REVIEW=
BREVO_TEMPLATE_DISPUTE_STATUS_CHANGE=
