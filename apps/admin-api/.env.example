# PostgreSQL (local Docker: docker compose up -d in apps/admin-api)
DATABASE_URL=postgresql://mercado:mercado@localhost:5433/mercado

# Server
PORT=8000

# Auth — change in production
JWT_SECRET=dev-secret-change-me

# Optional: absolute base URL for uploaded product images.
# Used when building imageUrl in API responses (product create/update).
# If unset, defaults to the incoming request host (fine for local dev).
# Set explicitly in production behind a reverse proxy or on a different domain.
# PUBLIC_BASE_URL=https://api.example.com
